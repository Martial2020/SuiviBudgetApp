		</MauiXaml>
		<MauiXaml Update="Views\ExecutionBudgetaireManageView.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\BudgetDetailManageView.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\BudgetDetailView.xaml">
			<Generator>MSBuild:Compile</Generator>
