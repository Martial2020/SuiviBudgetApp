<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- ✅ Plateformes ciblées -->
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>

		<!-- ❌ Supprimé : cette ligne provoque l’erreur WindowsAppSDKSelfContained -->
		<!-- <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks> -->

		<!-- ✅ Compatibilité Android -->
		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>21.0</TargetPlatformMinVersion>

		<!-- ✅ Désactive totalement l’usage du SDK Windows -->
		<WindowsEnableAppSdk>false</WindowsEnableAppSdk>

		<!-- ✅ Génère toutes les architectures pour Android -->
		<!--<RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>-->

		<!-- ✅ Évite les problèmes de build liés à AOT -->
		<PublishAot>false</PublishAot>

		<!-- ✅ Propriétés du projet -->
		<OutputType>Exe</OutputType>
		<RootNamespace>SuiviBuget.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- ✅ Informations de l’application -->
		<ApplicationTitle>SuiviBuget.Mobile</ApplicationTitle>
		<ApplicationId>com.companyname.suivibuget.mobile</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- ✅ Pas de packaging Windows -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- ✅ Version des plateformes -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<!-- ✅ Android SDK versions -->
		<AndroidMinSdkVersion>21</AndroidMinSdkVersion>
		<AndroidTargetSdkVersion>33</AndroidTargetSdkVersion>
		<AndroidSupportedAbis>armeabi-v7a;arm64-v8a;x86;x86_64</AndroidSupportedAbis>

		<!-- ✅ Signature Android (facultatif, à corriger si besoin) -->
		<!-- ⚠️ Le fichier de keystore doit être un .keystore, pas .txt -->
		<AndroidSigningKeyStore>MyApp.keystore</AndroidSigningKeyStore>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
		<AndroidKeyStore>False</AndroidKeyStore>
		<AndroidSigningStorePass>1994</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>bleu</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>1994</AndroidSigningKeyPass>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
		<AndroidKeyStore>False</AndroidKeyStore>
		<AndroidSigningStorePass>1994</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>bleu</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>1994</AndroidSigningKeyPass>
		<!-- Désactive le linker pour éviter que SkiaSharp soit supprimé -->
		<LinkerBehavior>None</LinkerBehavior>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->

		<!-- Splash Screen -->

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

