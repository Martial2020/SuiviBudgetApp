<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuiviBuget.Mobile.Views.RevenuDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SuiviBuget.Mobile.ViewModels;assembly=SuiviBuget.Mobile"
    Title="{Binding Title}">
    <!--  Liaison du ViewModel à la page  -->
    <ContentPage.BindingContext>
        <viewModels:RevenuDetailViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="5">

        <!--  Champ Montant  -->
        <Label FontAttributes="Bold" Text="Montant :" />
        <Entry
            x:Name="MontantEntry"
            Keyboard="Numeric"
            Placeholder="Entrez le montant"
            Text="{Binding DataItem.Montant, Mode=TwoWay}" />

        <Label FontAttributes="Bold" Text="Mode de réception :" />
        <Picker
            Title="Sélectionnez un mode de paiement"
            ItemDisplayBinding="{Binding LibelleModePaiement, Mode=TwoWay}"
            ItemsSource="{Binding ModePaiementItems, Mode=TwoWay}"
            SelectedItem="{Binding SelectedModePaiement, Mode=TwoWay}" />

        <Label FontAttributes="Bold" Text="Date:" />
        <DatePicker
            x:Name="DatePickerDebut"
            Date="{Binding DataItem.DateReception, Mode=TwoWay}"
            Format="dd/MM/yyyy" />

        <!--  Nouveau champ : Description  -->
        <Editor
            AutoSize="TextChanges"
            HeightRequest="100"
            Placeholder="Veuillez saisir le détail en quelques lignes"
            Text="{Binding DataItem.Description}" />


        <Button
            BackgroundColor="#FF7F50"
            Command="{Binding SubmitCommand}"
            CornerRadius="8"
            Text="{Binding LabelButton}"
            TextColor="White" />


    </VerticalStackLayout>
</ContentPage>