<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuiviBuget.Mobile.Views.ModePaiementView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SuiviBuget.Mobile.ViewModels;assembly=SuiviBuget.Mobile"
    Title="{Binding Title}"
    BackgroundColor="White">

    <!--  Liaison du ViewModel à la page  -->
    <ContentPage.BindingContext>
        <viewModels:ModePaiementViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="5">
        <Label FontAttributes="Bold" Text="Code :" />
        <Entry
            x:Name="CodeEntry"
            IsEnabled="{Binding IsEnabled, Mode=TwoWay}"
            Placeholder="Entrez le code du mode de paiement"
            Text="{Binding DataItem.CodeModePaiement, Mode=TwoWay}" />
        <Label FontAttributes="Bold" Text="Libellé :" />
        <Entry
            x:Name="LibelleEntry"
            Placeholder="Entrez le libellé du mode de paiement"
            Text="{Binding DataItem.LibelleModePaiement, Mode=TwoWay}" />
        <Button
            BackgroundColor="#FF7F50"
            Command="{Binding SubmitCommand}"
            CornerRadius="8"
            Text="{Binding LabelButton}"
            TextColor="White" />


    </VerticalStackLayout>
</ContentPage>
