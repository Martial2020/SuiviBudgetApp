<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuiviBuget.Mobile.Views.ExecutionBudgetaireManageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SuiviBudget.Mobile.Constants"
    xmlns:viewModels="clr-namespace:SuiviBuget.Mobile.ViewModels;assembly=SuiviBuget.Mobile"
    Title="Gestion des dépenses">

    <!--  Liaison du ViewModel à la page  -->
    <ContentPage.BindingContext>
        <viewModels:ExecutionBudgetaireManageViewModel />
    </ContentPage.BindingContext>


    <Grid RowDefinitions="Auto,Auto,*">

        <!--  SearchBar  -->
        <SearchBar
            Grid.Row="0"
            Margin="10,20,10,0"
            BackgroundColor="White"
            FontSize="16"
            HeightRequest="50"
            HorizontalOptions="FillAndExpand"
            Placeholder="Rechercher un budget..."
            Text="{Binding SearchText, Mode=TwoWay}"
            TextColor="Black"
            VerticalOptions="Start" />

        <!--  Boutons de filtre rectangulaires  -->
        <Grid
            Grid.Row="1"
            Margin="10,10,10,10"
            ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                BackgroundColor="{Binding TousBackground}"
                BorderColor="LightGray"
                BorderWidth="0.5"
                Command="{Binding FilterStatutCommand}"
                CommandParameter="{x:Static local:StatutBudgetConst.Tous}"
                CornerRadius="8"
                FontSize="12"
                HeightRequest="35"
                HorizontalOptions="FillAndExpand"
                Text="{Binding TousLabel}"
                TextColor="Black"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                BackgroundColor="{Binding EnCoursBackground}"
                BorderColor="LightGray"
                BorderWidth="0.5"
                Command="{Binding FilterStatutCommand}"
                CommandParameter="{x:Static local:StatutBudgetConst.Encours}"
                CornerRadius="8"
                FontSize="12"
                HeightRequest="35"
                HorizontalOptions="FillAndExpand"
                Text="{Binding EnCoursLabel}"
                TextColor="Black"
                VerticalOptions="Center" />
            <Button
                Grid.Column="2"
                BackgroundColor="{Binding ClotureBackground}"
                BorderColor="LightGray"
                BorderWidth="0.5"
                Command="{Binding FilterStatutCommand}"
                CommandParameter="{x:Static local:StatutBudgetConst.Cloture}"
                CornerRadius="8"
                FontSize="12"
                HeightRequest="35"
                HorizontalOptions="FillAndExpand"
                Text="{Binding ClotureLabel}"
                TextColor="Black"
                VerticalOptions="Center" />
        </Grid>
        <!--  Contenu  -->
        <AbsoluteLayout Grid.Row="2">

            <!--  CollectionView  -->
            <CollectionView
                x:Name="BudgetListView"
                Margin="0,0,0,0"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                ItemsSource="{Binding BudgetItems}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="10"
                            Padding="12"
                            BackgroundColor="AliceBlue"
                            CornerRadius="10"
                            HasShadow="True">


                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

                                <!--  Infos Budget  -->
                                <HorizontalStackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="2">
                                    <Label Text="{Binding CodeBudget}" />
                                    <Label Text="-" />
                                    <Label FontAttributes="Bold" Text="{Binding LibelleBudget}" />
                                </HorizontalStackLayout>
                                <!--  Bouton Actions modernisé (menu ⋮)  -->
                                <Button
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    BorderColor="#4682B4"
                                    BorderWidth="1"
                                    Command="{Binding Source={x:Reference BudgetListView}, Path=BindingContext.ExecutionBudgetDetailCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="20"
                                    FontSize="20"
                                    HeightRequest="40"
                                    HorizontalOptions="End"
                                    Text="⋮"
                                    TextColor="#4682B4"
                                    VerticalOptions="Center"
                                    WidthRequest="40" />
                                <!--  Dates  -->
                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="4">
                                    <Label Text="{Binding DateDebutBudget, StringFormat='Du : {0:dd/MM/yyyy}'}" TextColor="Gray" />
                                    <Label Text="{Binding DateFinBudget, StringFormat='Au : {0:dd/MM/yyyy}'}" TextColor="Gray" />
                                </HorizontalStackLayout>
                                <!--  Montants  -->
                                <!--  Montants  -->
                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Spacing="4">
                                    <Label Text="{Binding MontantBudget, StringFormat='Montant : {0:N0} FCFA'}" TextColor="#1E40AF" />
                                    <!--  Bleu foncé  -->
                                </HorizontalStackLayout>

                                <HorizontalStackLayout
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Margin="0,5,0,0"
                                    Spacing="8"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="Statut :"
                                        TextColor="#92400E"
                                        VerticalOptions="Center" />

                                    <Frame
                                        Padding="6,2"
                                        BackgroundColor="{Binding BackgroundColorStatut}"
                                        BorderColor="{Binding BackgroundColorStatut}"
                                        CornerRadius="4"
                                        HasShadow="False"
                                        VerticalOptions="Center">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="{Binding StatutBudget}"
                                            TextColor="White"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </Frame>
                                </HorizontalStackLayout>


                            </Grid>


                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Loader  -->
            <ActivityIndicator
                AbsoluteLayout.LayoutBounds="0.5,0.5,50,50"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                HeightRequest="50"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                WidthRequest="50"
                Color="DodgerBlue" />
        </AbsoluteLayout>
    </Grid>


</ContentPage>
