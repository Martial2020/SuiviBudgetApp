<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuiviBuget.Mobile.Views.ExecutionBudgetaireManageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SuiviBuget.Mobile.ViewModels;assembly=SuiviBuget.Mobile"
    Title="Gestion des dépenses">

    <!--  Liaison du ViewModel à la page  -->
    <ContentPage.BindingContext>
        <viewModels:ExecutionBudgetaireManageViewModel />
    </ContentPage.BindingContext>


    <Grid RowDefinitions="Auto,*">

        <!--  SearchBar  -->
        <SearchBar
            Grid.Row="0"
            Margin="10,20,10,0"
            BackgroundColor="White"
            FontSize="16"
            HeightRequest="50"
            HorizontalOptions="FillAndExpand"
            Placeholder="Rechercher un budget..."
            Text="{Binding SearchText, Mode=TwoWay}"
            TextColor="Black"
            VerticalOptions="Start" />

        <!--  Contenu  -->
        <AbsoluteLayout Grid.Row="1">

            <!--  CollectionView  -->
            <CollectionView
                x:Name="BudgetListView"
                Margin="0,0,0,0"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                ItemsSource="{Binding BudgetItems}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="10"
                            Padding="12"
                            BackgroundColor="AliceBlue"
                            Stroke="LightGray"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                                <!--  Infos Budget  -->
                                <VerticalStackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="1">
                                    <Label FontAttributes="Bold" Text="{Binding CodeBudget}" />
                                    <Label FontAttributes="Bold" Text="{Binding LibelleBudget}" />
                                </VerticalStackLayout>

                                <!--  Bouton Actions modernisé (menu ⋮)  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    BorderColor="#4682B4"
                                    BorderWidth="1"
                                    Command="{Binding Source={x:Reference BudgetListView}, Path=BindingContext.ExecutionBudgetDetailCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="20"
                                    FontSize="20"
                                    HeightRequest="40"
                                    HorizontalOptions="End"
                                    Text="⋮"
                                    TextColor="#4682B4"
                                    VerticalOptions="Center"
                                    WidthRequest="40" />

                                <!--  Dates  -->
                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="4">
                                    <Label Text="{Binding DateDebutBudget, StringFormat='Du : {0:dd/MM/yyyy}'}" TextColor="Gray" />
                                    <Label Text="{Binding DateFinBudget, StringFormat='Au : {0:dd/MM/yyyy}'}" TextColor="Gray" />
                                </HorizontalStackLayout>

                                <!--  Montants  -->
                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Spacing="4">
                                    <Label Text="{Binding MontantBudget, StringFormat='Solde : {0:N0} FCFA'}" TextColor="#1E3A8A" />
                                    <!--<Label Text="{Binding MontantRestant, StringFormat='Rest : {0:N0} FCFA'}" TextColor="Blue"/>-->
                                </HorizontalStackLayout>

                                <!--  Statut  -->
                                <HorizontalStackLayout
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="Start"
                                    Spacing="4">
                                    <Label Text="{Binding MontantUtilise, StringFormat='Utilisé : {0:N0} FCFA'}" TextColor="#F59E0B" />
                                </HorizontalStackLayout>

                                <!--  Statut  -->
                                <HorizontalStackLayout
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="Start"
                                    Spacing="4">
                                    <Label Text="{Binding MontantRestant, StringFormat='Restant : {0:N0} FCFA'}" TextColor="#16A34A" />
                                </HorizontalStackLayout>



                                <HorizontalStackLayout
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="End"
                                    Spacing="15">
                                    <Label
                                        FontAttributes="Italic"
                                        Text="{Binding StatutBudget}"
                                        TextColor="Red" />
                                </HorizontalStackLayout>

                            </Grid>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Loader  -->
            <ActivityIndicator
                AbsoluteLayout.LayoutBounds="0.5,0.5,50,50"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                HeightRequest="50"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                WidthRequest="50"
                Color="DodgerBlue" />
        </AbsoluteLayout>
    </Grid>


</ContentPage>
