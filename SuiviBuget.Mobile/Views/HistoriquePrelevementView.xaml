<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuiviBuget.Mobile.Views.HistoriquePrelevementView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SuiviBuget.Mobile.ViewModels;assembly=SuiviBuget.Mobile"
    Title="Historique des prélévements">

    <!--  Liaison du ViewModel à la page  -->
    <ContentPage.BindingContext>
        <viewModels:HistoriquePrelevementViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *">
        <!--  Contenu  -->
        <AbsoluteLayout Grid.Row="1">
            <!--  CollectionView  -->
            <CollectionView
                x:Name="modepList"
                Margin="10,0,10,10"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                ItemsSource="{Binding Prelevementstems}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="5"
                            Padding="5"
                            BackgroundColor="AliceBlue"
                            CornerRadius="10"
                            HasShadow="True">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding DateCreation, StringFormat='Date creation : {0:dd/MM/yyyy}'}" />
                                    <Label Text="{Binding LibelleBudget, StringFormat='Budget : {0}'}" />
                                    <Label Text="{Binding MontantAvecDevise, StringFormat='Montant : {0}'}" />
                                    <Label Text="{Binding EstAnnule, StringFormat='Annulé : {0}'}" />
                                </VerticalStackLayout>


                            </Grid>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <!--  Loader  -->
            <ActivityIndicator
                AbsoluteLayout.LayoutBounds="0.5,0.5,50,50"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                HeightRequest="50"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                WidthRequest="50"
                Color="DodgerBlue" />
        </AbsoluteLayout>
    </Grid>
</ContentPage>