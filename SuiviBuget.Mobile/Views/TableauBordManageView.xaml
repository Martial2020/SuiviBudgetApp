<ContentPage
    x:Class="SuiviBuget.Mobile.Views.TableauBordManageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    xmlns:viewModels="clr-namespace:SuiviBuget.Mobile.ViewModels;assembly=SuiviBuget.Mobile"
    Title="Tableau de bord">

    <!--  Liaison du ViewModel à la page  -->
    <ContentPage.BindingContext>
        <viewModels:TableauBordManageViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!--  Contenu principal  -->
        <ScrollView>
            <VerticalStackLayout Padding="10" Spacing="15">
                <Picker
                    Title="Sélectionnez un budget"
                    ItemDisplayBinding="{Binding LibelleBudget, Mode=TwoWay}"
                    ItemsSource="{Binding BudgetItems, Mode=TwoWay}"
                    SelectedItem="{Binding SelectedBudget, Mode=TwoWay}" />
                <Frame
                    Padding="5"
                    BackgroundColor="White"
                    CornerRadius="15"
                    HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            Text="🏦 Information du budget"
                            TextColor="#2C3E50" />
                        <Grid
                            Padding="5"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="5"
                            IsVisible="{Binding IsVisibleBudgetDetail}"
                            RowDefinitions="*,*"
                            RowSpacing="5">
                            <!--  Badge Montant  -->
                            <Frame
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="8,4"
                                BackgroundColor="AliceBlue"
                                CornerRadius="12"
                                HasShadow="True">
                                <Label Text="{Binding SelectedBudget.MontantBudget, StringFormat='💰 Budget : {0:N0} CFA'}" TextColor="Black" />
                            </Frame>
                            <Frame
                                Grid.Row="0"
                                Grid.Column="1"
                                Padding="8,4"
                                BackgroundColor="AliceBlue"
                                CornerRadius="12"
                                HasShadow="True">
                                <Label Text="{Binding SelectedBudget.MontantUtilise, StringFormat='💳 Utilisé : {0:N0} CFA'}" TextColor="Black" />
                            </Frame>
                            <Frame
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="8,4"
                                BackgroundColor="AliceBlue"
                                CornerRadius="12"
                                HasShadow="True">
                                <Label Text="{Binding SelectedBudget.MontantRestant, StringFormat='💵 Reste : {0:N0} CFA'}" TextColor="Black" />
                            </Frame>
                            <!--  Badge Période  -->
                            <Frame
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="8,4"
                                BackgroundColor="AliceBlue"
                                CornerRadius="12"
                                HasShadow="True">
                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="4">
                                    <Label Text="{Binding SelectedBudget.DateDebutBudget, StringFormat='📅 {0:dd/MM/yyyy}'}" TextColor="Black" />
                                    <Label Text="{Binding SelectedBudget.DateFinBudget, StringFormat=' - {0:dd/MM/yyyy}'}" TextColor="Black" />
                                </HorizontalStackLayout>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>

                </Frame>

                <!--  Section Dépassements  -->
                <Frame
                    Padding="15"
                    BackgroundColor="White"
                    CornerRadius="15"
                    HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            Text="🧾 Répartition des types de dépenses"
                            TextColor="#2C3E50" />
                        <!--  Graphique  -->
                        <microcharts:ChartView Chart="{Binding Chart}" HeightRequest="300" />
                    </VerticalStackLayout>
                </Frame>
                <!--  Section Dépassements  -->
                <Frame
                    Padding="15"
                    BackgroundColor="White"
                    CornerRadius="15"
                    HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="Start"
                                Text="🚨 Dépassements :"
                                TextColor="Red" />

                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="End"
                                Text="{Binding TotalDepassement, StringFormat='{0:N0} FCFA'}"
                                TextColor="Red" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding DepassementItems}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame
                                        Margin="0,5"
                                        Padding="10"
                                        BackgroundColor="#FFEAEA"
                                        CornerRadius="10">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <!--  Colonne libellé et budget  -->
                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="2">
                                                <Label
                                                    FontAttributes="Bold"
                                                    Text="{Binding LibelleLigneBudgetaire}"
                                                    TextColor="#C0392B" />
                                            </VerticalStackLayout>

                                            <!--  Montant à droite  -->
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                FontAttributes="Bold"
                                                Text="{Binding Montant, StringFormat='{0:N0} FCFA'}"
                                                TextColor="#E74C3C"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!--  Section Dépenses du jour  -->
                <Frame
                    Padding="15"
                    BackgroundColor="White"
                    CornerRadius="15"
                    HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="Start"
                                Text="📅 Dépenses du jour :"
                                TextColor="Black" />

                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="End"
                                Text="{Binding TotalDepense, StringFormat='{0:N0} FCFA'}"
                                TextColor="Black" />
                        </Grid>
                        <CollectionView ItemsSource="{Binding ExecutionBudgetaireItems}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame
                                        Margin="0,5"
                                        Padding="10"
                                        BackgroundColor="AliceBlue"
                                        CornerRadius="10">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    FontAttributes="Bold"
                                                    Text="{Binding LibelleLigneBudgetaire}"
                                                    TextColor="Black" />
                                                <Label
                                                    FontAttributes="Italic"
                                                    Text="{Binding Description}"
                                                    TextColor="#7F8C8D" />

                                            </VerticalStackLayout>
                                            <Label
                                                Grid.Column="1"
                                                FontAttributes="Bold"
                                                Text="{Binding Montant, StringFormat='{0:N0} FCFA'}"
                                                TextColor="#27AE60"
                                                VerticalOptions="Center" />

                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Loader centré  -->
        <ActivityIndicator
            HeightRequest="40"
            HorizontalOptions="CenterAndExpand"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="CenterAndExpand"
            WidthRequest="40"
            Color="#4682B4" />

    </Grid>

</ContentPage>