<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuiviBuget.Mobile.Views.BudgetManageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SuiviBudget.Mobile.Constants"
    xmlns:viewModels="clr-namespace:SuiviBuget.Mobile.ViewModels;assembly=SuiviBuget.Mobile"
    Title="Liste des budgets">

    <!--  Liaison du ViewModel à la page  -->
    <ContentPage.BindingContext>
        <viewModels:BudgetManageViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="Auto,Auto,*">

        <!--  SearchBar  -->
        <SearchBar
            Grid.Row="0"
            Margin="10"
            BackgroundColor="White"
            HeightRequest="50"
            HorizontalOptions="FillAndExpand"
            Placeholder="Rechercher un budget..."
            Text="{Binding SearchText, Mode=TwoWay}"
            TextColor="Black"
            VerticalOptions="Start" />

        <!--  Boutons de filtre rectangulaires  -->
        <Grid
            Grid.Row="1"
            Margin="10,10,10,10"
            ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                BackgroundColor="{Binding TousBackground}"
                BorderColor="LightGray"
                BorderWidth="0.5"
                Command="{Binding FilterStatutCommand}"
                CommandParameter="{x:Static local:StatutBudgetConst.Tous}"
                CornerRadius="8"
                FontSize="12"
                HeightRequest="35"
                HorizontalOptions="FillAndExpand"
                Text="{Binding TousLabel}"
                TextColor="Black"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                BackgroundColor="{Binding OuvertBackground}"
                BorderColor="LightGray"
                BorderWidth="0.5"
                Command="{Binding FilterStatutCommand}"
                CommandParameter="{x:Static local:StatutBudgetConst.Ouvert}"
                CornerRadius="8"
                FontSize="12"
                HeightRequest="35"
                HorizontalOptions="FillAndExpand"
                Text="{Binding OuvertLabel}"
                TextColor="Black"
                VerticalOptions="Center" />
            <Button
                Grid.Column="2"
                BackgroundColor="{Binding EnCoursBackground}"
                BorderColor="LightGray"
                BorderWidth="0.5"
                Command="{Binding FilterStatutCommand}"
                CommandParameter="{x:Static local:StatutBudgetConst.Encours}"
                CornerRadius="8"
                FontSize="12"
                HeightRequest="35"
                HorizontalOptions="FillAndExpand"
                Text="{Binding EnCoursLabel}"
                TextColor="Black"
                VerticalOptions="Center" />
            <Button
                Grid.Column="3"
                BackgroundColor="{Binding ClotureBackground}"
                BorderColor="LightGray"
                BorderWidth="0.5"
                Command="{Binding FilterStatutCommand}"
                CommandParameter="{x:Static local:StatutBudgetConst.Cloture}"
                CornerRadius="8"
                FontSize="12"
                HeightRequest="35"
                HorizontalOptions="FillAndExpand"
                Text="{Binding ClotureLabel}"
                TextColor="Black"
                VerticalOptions="Center" />
        </Grid>

        <!--  Contenu  -->
        <AbsoluteLayout Grid.Row="2">

            <!--  CollectionView  -->
            <!--  CollectionView  -->
            <CollectionView
                Margin="0,0,0,0"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                ItemsSource="{Binding BudgetItems}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="10"
                            Padding="10"
                            BackgroundColor="AliceBlue"
                            CornerRadius="10"
                            HasShadow="True">

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                                <!--  Infos Budget  -->
                                <VerticalStackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="1">
                                    <Label FontAttributes="Bold" Text="{Binding CodeBudget}" />
                                    <Label FontAttributes="Bold" Text="{Binding LibelleBudget}" />
                                </VerticalStackLayout>

                                <!--  Bouton Actions modernisé (menu ⋮)  -->
                                <Button
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Margin="0"
                                    BackgroundColor="Transparent"
                                    BorderColor="#4682B4"
                                    BorderWidth="1"
                                    Clicked="OnActionsClicked"
                                    CornerRadius="20"
                                    FontSize="20"
                                    HeightRequest="40"
                                    HorizontalOptions="End"
                                    Text="⋮"
                                    TextColor="#4682B4"
                                    VerticalOptions="Center"
                                    WidthRequest="40" />

                                <!--  Dates  -->
                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="4">
                                    <Label Text="{Binding DateDebutBudget, StringFormat='Du : {0:dd/MM/yyyy}'}" TextColor="Gray" />
                                    <Label Text="{Binding DateFinBudget, StringFormat='Au : {0:dd/MM/yyyy}'}" TextColor="Gray" />
                                </HorizontalStackLayout>

                                <!--  Montants  -->
                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Spacing="4">
                                    <Label Text="{Binding MontantBudget, StringFormat='Solde : {0:N0} FCFA'}" TextColor="#1E3A8A" />
                                    <!--<Label Text="{Binding MontantRestant, StringFormat='Rest : {0:N0} FCFA'}" TextColor="Blue"/>-->
                                </HorizontalStackLayout>

                                <!--  Statut  -->
                                <HorizontalStackLayout
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="Start"
                                    Spacing="4">
                                    <Label Text="{Binding MontantUtilise, StringFormat='Utilisé : {0:N0} FCFA'}" TextColor="#F59E0B" />
                                </HorizontalStackLayout>

                                <!--  Statut  -->
                                <HorizontalStackLayout
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="Start"
                                    Spacing="4">
                                    <Label Text="{Binding MontantRestant, StringFormat='Restant : {0:N0} FCFA'}" TextColor="#16A34A" />
                                </HorizontalStackLayout>



                                <HorizontalStackLayout
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="End"
                                    Spacing="15">

                                    <Frame
                                        Padding="8"
                                        BackgroundColor="{Binding BackgroundColorStatut}"
                                        CornerRadius="15">
                                        <Label
                                            FontAttributes="Bold"
                                            Text="{Binding StatutBudget}"
                                            TextColor="White" />
                                    </Frame>

                                    <!--<Label
                                        FontAttributes="Italic"
                                        Text="{Binding StatutBudget}"
                                        TextColor="Red" />-->
                                </HorizontalStackLayout>

                            </Grid>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <!--  Bouton "+" flottant  -->
            <Button
                AbsoluteLayout.LayoutBounds="0.9,0.9,60,60"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                BackgroundColor="#FF7F50"
                Command="{Binding AddBugetCommand}"
                CornerRadius="30"
                FontSize="30"
                HeightRequest="60"
                Text="+"
                TextColor="White"
                WidthRequest="60"
                ZIndex="5" />

            <!--  Loader  -->
            <ActivityIndicator
                AbsoluteLayout.LayoutBounds="0.5,0.5,50,50"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                HeightRequest="50"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                WidthRequest="50"
                Color="DodgerBlue" />

        </AbsoluteLayout>
    </Grid>



</ContentPage>
