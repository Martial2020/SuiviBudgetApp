<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SuiviBuget.Mobile.Views.ExecutionBudgetaireManageDetailView"
             xmlns:viewModels="clr-namespace:SuiviBuget.Mobile.ViewModels;assembly=SuiviBuget.Mobile"
             Title="{Binding Title}">

    <!-- Liaison du ViewModel à la page -->
    <ContentPage.BindingContext>
        <viewModels:ExecutionBudgetaireManageDetailViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *">
        <!-- ComboBox (Picker dans MAUI) -->
            <Picker Title="Sélectionnez une ligne budgetaire" Grid.Row="0"
               Margin="10,0,10,10" HorizontalOptions="FillAndExpand"  VerticalOptions="Start"
               HeightRequest="50" VerticalTextAlignment="Center" 
               ItemsSource="{Binding LigneBudgetaireItems,Mode=TwoWay}" 
               ItemDisplayBinding="{Binding LibelleLigneBudgetaire, Mode=TwoWay}" 
               SelectedItem="{Binding SelectedLigneBudgetaire, Mode=TwoWay}"
               IsEnabled="{Binding CodeLigneBudgetaireIsEnabled,Mode=TwoWay}"/>

            <!-- Contenu -->
        <AbsoluteLayout Grid.Row="1">
            <!-- CollectionView -->
            <CollectionView ItemsSource="{Binding ExecutionBugetaireDetailItems}"
            Margin="10,0,10,10"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="LightGray"   StrokeThickness="1"
                      BackgroundColor="AliceBlue" Margin="10"  Padding="6" >
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <!-- Infos Budget -->
                                <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="4">
                                    <Label Text="{Binding DateExecution, StringFormat='{0:dd/MM/yyyy}'}" />
                                    <Label Text="{Binding LibelleLigneBudgetaire}"/>

                                    <!-- Dates -->
                                    <HorizontalStackLayout Spacing="4" Grid.Column="0" Grid.Row="0">
                                        <Label Text="{Binding ModePaiement,StringFormat='{0} : '}"/>
                                        <Label Text="{Binding Montant, StringFormat='{0:N0} FCFA'}"/>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                                <!-- Bouton Actions modernisé (menu ⋮) -->
                                <Button Grid.Column="1" Grid.Row="0"
                                    Text="⋮"
                                    FontSize="20"
                                    BackgroundColor="Transparent"
                                    TextColor="#4682B4"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    BorderColor="#4682B4"
                                    BorderWidth="1"
                                    Clicked="Button_Clicked"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"/>

                            </Grid>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <!-- Bouton "+" flottant -->
            <Button Text="+"  x:Name="btnAjouter2"
                BackgroundColor="#FF7F50"
                TextColor="White"
                FontSize="30"
                WidthRequest="60" HeightRequest="60"
                CornerRadius="30"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                AbsoluteLayout.LayoutBounds="0.9,0.9,60,60"
                ZIndex="5"
                Command="{Binding AddCommand}"/>
            <!-- Loader -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
               IsVisible="{Binding IsBusy}"
               Color="DodgerBlue"
               WidthRequest="50"
               HeightRequest="50"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               AbsoluteLayout.LayoutFlags="PositionProportional"
               AbsoluteLayout.LayoutBounds="0.5,0.5,50,50"/>
        </AbsoluteLayout>
    </Grid>
</ContentPage>