<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuiviBuget.Mobile.Views.ExecutionBudgetaireManageDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SuiviBuget.Mobile.ViewModels;assembly=SuiviBuget.Mobile"
    x:Name="ExecutionPage"
    Title="{Binding Title}">

    <!--  Liaison du ViewModel à la page  -->
    <ContentPage.BindingContext>
        <viewModels:ExecutionBudgetaireManageDetailViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto, *">
        <!--  ComboBox (Picker dans MAUI)  -->
        <Picker
            Title="Sélectionnez un type de dépense"
            Grid.Row="0"
            Margin="10,0,10,10"
            HeightRequest="50"
            HorizontalOptions="FillAndExpand"
            IsEnabled="{Binding CodeLigneBudgetaireIsEnabled, Mode=TwoWay}"
            ItemDisplayBinding="{Binding LibelleLigneBudgetaire, Mode=TwoWay}"
            ItemsSource="{Binding LigneBudgetaireItems, Mode=TwoWay}"
            SelectedItem="{Binding SelectedLigneBudgetaire, Mode=TwoWay}"
            VerticalOptions="Start"
            VerticalTextAlignment="Center" />

        <Frame
            x:Name="BadgeFrame"
            Grid.Row="1"
            Margin="15"
            Padding="20"
            BackgroundColor="White"
            BorderColor="#E0E0E0"
            CornerRadius="20"
            HasShadow="True"
            HorizontalOptions="FillAndExpand"
            IsVisible="{Binding IsVisibleBadgeFrame}"
            VerticalOptions="FillAndExpand">

            <VerticalStackLayout Spacing="15">

                <!--  Première ligne : Montant  -->
                <Label
                    x:Name="LblMontant"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Text="{Binding MontantBudget, StringFormat='Montant : {0:N0} FCFA'}"
                    TextColor="Green" />

                <!--  Deuxième ligne : Utilisé et Restant  -->
                <Grid
                    Padding="3,0"
                    ColumnDefinitions="*,*"
                    VerticalOptions="Center">
                    <Label
                        x:Name="LblUtilise"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        Text="{Binding MontantUtilise, StringFormat='Utilisé : {0:N0} FCFA'}"
                        TextColor="#1565C0" />

                    <Label
                        x:Name="LblRestant"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        HorizontalOptions="End"
                        Text="{Binding MontantRestant, StringFormat='Restant : {0:N0} FCFA'}"
                        TextColor="#D32F2F" />
                </Grid>
                <!--  Barre de progression  -->
                <VerticalStackLayout>
                    <!--  Barre de progression  -->
                    <ProgressBar
                        HeightRequest="30"
                        Progress="{Binding ProgressValue}"
                        ProgressColor="{Binding ProgressColor}" />

                    <!--  Pourcentage affiché  -->
                    <Label
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        Text="{Binding ProgressText}"
                        TextColor="{Binding ProgressColor}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Frame>


        <!--  Contenu  -->
        <AbsoluteLayout Grid.Row="2">
            <!--  CollectionView  -->
            <CollectionView
                Margin="10,0,10,10"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                ItemsSource="{Binding ExecutionBugetaireDetailItems}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="10"
                            Padding="6"
                            BackgroundColor="AliceBlue"
                            CornerRadius="10"
                            HasShadow="True">

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <!--  Infos Budget  -->
                                <VerticalStackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="4">

                                    <!--  Date  -->
                                    <Label
                                        FontAttributes="Bold"
                                        Text="{Binding DateExecution, StringFormat='{0:dd/MM/yyyy}'}"
                                        TextColor="#2C3E50" />

                                    <!--  Libelle ligne budgetaire  -->
                                    <Label
                                        FontAttributes="Bold"
                                        Text="{Binding LibelleLigneBudgetaire}"
                                        TextColor="Black" />


                                    <!--  Mode paiement + montant  -->
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{Binding ModePaiement, StringFormat='{0} : '}" TextColor="#2C3E50" />
                                        <Label
                                            FontAttributes="Bold"
                                            Text="{Binding Montant, StringFormat='{0:N0} FCFA'}"
                                            TextColor="#27AE60" />

                                    </HorizontalStackLayout>
                                    <!--  ✅ Description ajoutée  -->
                                    <Label
                                        FontAttributes="Italic"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Description}"
                                        TextColor="#7F8C8D" />


                                </VerticalStackLayout>

                                <!--  Bouton Actions modernisé (menu ⋮)  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    BorderColor="#4682B4"
                                    BorderWidth="1"
                                    Clicked="Button_Clicked"
                                    CornerRadius="20"
                                    FontSize="20"
                                    HeightRequest="40"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding Source={x:Reference ExecutionPage}, Path=BindingContext.ActionPossible}"
                                    Text="⋮"
                                    TextColor="#4682B4"
                                    VerticalOptions="Center"
                                    WidthRequest="40" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Bouton "+" flottant  -->
            <Button
                x:Name="btnAjouter2"
                AbsoluteLayout.LayoutBounds="0.9,0.9,60,60"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                BackgroundColor="#FF7F50"
                Command="{Binding AddCommand}"
                CornerRadius="30"
                FontSize="30"
                HeightRequest="60"
                IsVisible="{Binding ActionPossible}"
                Text="+"
                TextColor="White"
                WidthRequest="60"
                ZIndex="5" />
            <!--  Loader  -->
            <ActivityIndicator
                AbsoluteLayout.LayoutBounds="0.5,0.5,50,50"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                HeightRequest="50"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                WidthRequest="50"
                Color="DodgerBlue" />
        </AbsoluteLayout>
    </Grid>
</ContentPage>