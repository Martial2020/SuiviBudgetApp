<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuiviBuget.Mobile.Views.ParametreManageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Gestion des paramètres">
    <Grid RowDefinitions="Auto, *">
        <!--  Première ligne pour la barre de recherche  -->
        <SearchBar
            Grid.Row="0"
            Margin="10,20,10,0"
            BackgroundColor="White"
            FontSize="16"
            HeightRequest="50"
            HorizontalOptions="FillAndExpand"
            Placeholder="Rechercher d'un paramètre..."
            TextColor="Black"
            VerticalOptions="Start"
            VerticalTextAlignment="Center" />
        <!--  Affecter à la première ligne (Row 0)  -->
        <CollectionView
            Grid.Row="1"
            Margin="10,0,10,10"
            ItemsSource="{Binding BudgetItems}"
            VerticalOptions="FillAndExpand">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="10"
                        Padding="12"
                        BackgroundColor="AliceBlue"
                        Stroke="LightGray"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="5">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding LibelleBudget}" />
                            <!--  Dates  -->
                            <HorizontalStackLayout Spacing="15">
                                <Label
                                    FontSize="13"
                                    Text="{Binding DateDebutBudget, StringFormat='Début : {0:dd/MM/yyyy}'}"
                                    TextColor="Gray" />
                                <Label
                                    FontSize="13"
                                    Text="{Binding DateFinBudget, StringFormat='Fin : {0:dd/MM/yyyy}'}"
                                    TextColor="Gray" />
                            </HorizontalStackLayout>
                            <!--  Montants  -->
                            <HorizontalStackLayout Spacing="15">
                                <Label
                                    FontSize="13"
                                    Text="{Binding MontantBudget, StringFormat='Mnt : {0:N0} FCFA'}"
                                    TextColor="#32CD32" />
                                <Label
                                    FontSize="13"
                                    Text="{Binding MontantBudget, StringFormat='Cons : {0:N0} FCFA'}"
                                    TextColor="#FF6347" />
                                <Label
                                    FontSize="13"
                                    Text="{Binding MontantBudget, StringFormat='Rest : {0:N0} FCFA'}"
                                    TextColor="#1E90FF" />
                            </HorizontalStackLayout>
                            <!--  Statut  -->
                            <Label
                                FontAttributes="Italic"
                                FontSize="13"
                                HorizontalOptions="Start"
                                Text="{Binding Statut}"
                                TextColor="DarkSlateGray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!--  Bouton flottant circulaire "Ajouter"  -->
        <Button
            Grid.Row="1"
            Margin="20"
            BackgroundColor="#FF7F50"
            CornerRadius="30"
            FontSize="30"
            HeightRequest="60"
            HorizontalOptions="End"
            Text="+"
            TextColor="White"
            VerticalOptions="End"
            WidthRequest="60"
            ZIndex="1" />
    </Grid>

</ContentPage>