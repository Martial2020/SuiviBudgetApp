<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuiviBuget.Mobile.Views.StatistiqueManageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    xmlns:viewModels="clr-namespace:SuiviBuget.Mobile.ViewModels;assembly=SuiviBuget.Mobile"
    Title="Statistiques">

    <!--  Liaison du ViewModel à la page  -->
    <ContentPage.BindingContext>
        <viewModels:StatistiqueManageViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="20">

            <!--  Filtres par période et budget  -->
            <!--  Filtres par période  -->
            <Frame
                Padding="10"
                BorderColor="LightGray"
                CornerRadius="10"
                HasShadow="True">
                <VerticalStackLayout>
                    <Label FontAttributes="Bold" Text="📅 Critères de recherche" />
                    <DatePicker x:Name="StartDatePicker" Date="{Binding DateDebut, Mode=TwoWay}" />
                    <DatePicker x:Name="EndDatePicker" Date="{Binding DateFin, Mode=TwoWay}" />
                    <!--  Budget  -->
                    <Picker
                        Title="Sélectionnez un budget"
                        ItemDisplayBinding="{Binding LibelleBudget, Mode=TwoWay}"
                        ItemsSource="{Binding BudgetItems, Mode=TwoWay}"
                        SelectedItem="{Binding SelectedBudget, Mode=TwoWay}" />
                    <Button
                        BackgroundColor="#FF7F50"
                        Command="{Binding SubmitCommand}"
                        CornerRadius="8"
                        IsEnabled="{Binding IsEnabled}"
                        Text="{Binding RechercherLabel}"
                        TextColor="White" />

                </VerticalStackLayout>

            </Frame>

            <!--  Bloc 3 : Courbe évolution  -->
            <Frame
                Padding="10"
                BorderColor="LightGray"
                CornerRadius="10"
                HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" Text="📈 Top 7 des budgets par valeurs en FCFA" />
                    <!--  Graphique  -->
                    <microcharts:ChartView Chart="{Binding Chart}" HeightRequest="{Binding ChartHeight}" />
                </VerticalStackLayout>
            </Frame>


            <!--  Bloc : Consommation par ligne budgétaire  -->
            <Frame
                Padding="10"
                BorderColor="LightGray"
                CornerRadius="10">
                <VerticalStackLayout>
                    <Label FontAttributes="Bold" Text="📊 Consommation par type de depense en FCFA" />
                    <!--  DonutChart  -->
                    <microcharts:ChartView Chart="{Binding TopDepensesChart}" HeightRequest="{Binding ChartHeight}" />
                </VerticalStackLayout>
            </Frame>

            <!--  Bloc 2 : Depense en fonction de la data  -->
            <Frame
                Padding="15"
                BackgroundColor="White"
                CornerRadius="15"
                HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            Text="📅 Dépenses par période :"
                            TextColor="#2C3E50" />

                        <Label
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            Text="{Binding TotalDepense, StringFormat='{0:N0} FCFA'}"
                            TextColor="#2C3E50" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding ExecutionBudgetaireItems}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    Margin="0,5"
                                    Padding="10"
                                    BackgroundColor="AliceBlue"
                                    CornerRadius="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                Text="{Binding LibelleLigneBudgetaire}"
                                                TextColor="Black" />
                                            <Label
                                                FontAttributes="Italic"
                                                Text="{Binding Description}"
                                                TextColor="#7F8C8D" />

                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            Text="{Binding Montant, StringFormat='{0:N0} FCFA'}"
                                            TextColor="#27AE60"
                                            VerticalOptions="Center" />

                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>



            <!--  Bloc 2 : Dépassements  -->

            <Frame
                Padding="15"
                BackgroundColor="White"
                CornerRadius="15"
                HasShadow="True">
                <VerticalStackLayout Margin="0,5" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            Text="🚨 Dépassements par type de dépense :"
                            TextColor="Black" />

                        <Label
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            Text="{Binding TotalDepassement, StringFormat='{0:N0} FCFA'}"
                            TextColor="Black" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding DepassementsItems}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    Margin="0,5"
                                    Padding="10"
                                    BackgroundColor="#FFEAEA"
                                    CornerRadius="10">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <!--  Colonne libellé et budget  -->
                                        <VerticalStackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                Text="{Binding LigneBudgetaire}"
                                                TextColor="#C0392B" />
                                        </VerticalStackLayout>

                                        <!--  Montant à droite  -->
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            Text="{Binding Depassement, StringFormat='{0:N0} FCFA'}"
                                            TextColor="#E74C3C"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
