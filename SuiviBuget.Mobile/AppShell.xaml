<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SuiviBuget.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SuiviBuget.Mobile.Views"
    xmlns:viewmodels="clr-namespace:SuiviBuget.Mobile.ViewModels"
    Title="SuiviBuget.Mobile"
    Shell.TabBarBackgroundColor="White">

    <!--  Shell.FlyoutBehavior="Flyout"  -->

    <Shell.BindingContext>
        <viewmodels:AppShellViewModel />
    </Shell.BindingContext>

    <!--  Header avec les 3 points  -->
    <Shell.ToolbarItems>
        <ToolbarItem Command="{Binding ShowMenuCommand}" IconImageSource="setting.png" />
    </Shell.ToolbarItems>

    <!--  Barre d'onglets  -->
    <TabBar>
        <Tab
            x:Name="AccueilTab"
            Title="Accueil"
            Icon="accueil.png">
            <ShellContent ContentTemplate="{DataTemplate local:TableauBordManageView}" />
        </Tab>
        <!--<Tab Title="Source de revenu" Icon="revenu.png">
            <ShellContent ContentTemplate="{DataTemplate local:RevenuManageView}" />
        </Tab>-->
        <Tab Title="Budgets" Icon="budget.png">
            <ShellContent ContentTemplate="{DataTemplate local:BudgetManageView}" />
        </Tab>

        <!--<Tab Title="Dépenses" Icon="execution.png">
            <ShellContent ContentTemplate="{DataTemplate local:ExecutionBudgetaireManageView}" />
        </Tab>-->

        <Tab Title="Statistiques" Icon="report.png">
            <ShellContent ContentTemplate="{DataTemplate local:StatistiqueManageView}" />
        </Tab>
    </TabBar>

</Shell>
